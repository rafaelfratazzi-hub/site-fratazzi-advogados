# Desabilitar cache para blog.js e blog.html (atualizados diariamente)
<FilesMatch "(blog\.js|blog\.html)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</FilesMatch>

# LiteSpeed Cache: desabilitar para blog.js e blog.html
<IfModule LiteSpeed>
    CacheDisable /js/blog.js
    CacheDisable /blog.html
</IfModule>

# MIME Types para vídeo
AddType video/mp4 .mp4
AddType video/webm .webm
AddType video/ogg .ogv

# CRÍTICO: Desabilitar compressão para arquivos de vídeo
# Compressão gzip/brotli quebra o streaming de vídeo no navegador
<FilesMatch "\.(mp4|webm|ogv|ogg|mov|avi|mkv)$">
    SetEnv no-gzip 1
    SetEnv no-brotli 1
    Header always set Accept-Ranges "bytes"
    Header always set Cache-Control "public, max-age=3600"
    Header always set X-Content-Type-Options "nosniff"
</FilesMatch>

# Garantir que o servidor suporta byte-range requests (necessário para vídeo)
<IfModule mod_headers.c>
    Header always set Accept-Ranges bytes
</IfModule>
